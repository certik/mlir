// The static attribute keys: one MLIR_ATTR_KEY(enumerator, name) line per
// attribute name the in-tree code uses (doc/mlir_api_design.md section 2.6).
//
// An X-macro, like mlir_ops.def: define MLIR_ATTR_KEY, include the file, and
// it #undefs the macro at the end. It generates the MLIR_KEY_* enumerators
// (mlir_api.h) and the name of each (mlir_op_names.c). Any other name gets a
// dynamic key from its context (MLIR_InternAttrKey). Names are unique
// (checked when a context is created); values are not ABI-stable.
//
// The enumerator is MLIR_KEY_ and the name in upper snake case (`.` and a
// leading `_` dropped); names that would collide (`_step`) stay dynamic.

#ifndef MLIR_ATTR_KEY
#define MLIR_ATTR_KEY(enumerator, name)
#endif

MLIR_ATTR_KEY(MLIR_KEY_ADDEND, "addend")
MLIR_ATTR_KEY(MLIR_KEY_ALIGN_POW, "align_pow")
MLIR_ATTR_KEY(MLIR_KEY_ARG_ATTRS, "arg_attrs")
