// An integer used as a pointer without a cast converts to that pointer
// (with a warning), as in gcc -fpermissive (#365). It used to become the
// null pointer. A constant 0 is still a null pointer constant.
extern int printf(const char *fmt, ...);
typedef unsigned long uintptr_t;
#define NULL ((void *)0)
struct S { int v; };
struct P { int tag; char *name; void *data; };
static unsigned long show(const void *p) { return (unsigned long)p; }
static unsigned long show_c(char *p) { return (unsigned long)p; }
static unsigned long show_i(int *p) { return (unsigned long)p; }
static unsigned long show_pp(void **p) { return (unsigned long)p; }
// `b == NULL` compared the null pointer with itself.
static int is_null(uintptr_t b) { return b == NULL; }
static int not_null(uintptr_t b) { return NULL != b; }
static int same(char *p, uintptr_t b) { return p == b; }
static int differ(uintptr_t b, char *p) { return b != p; }
// Null pointer constants: a return value and a struct-pointer argument.
static unsigned long show_s(struct S *p) { return (unsigned long)p; }
static char *ret_zero(void) { return 0; }
static void *ret_int(uintptr_t k) { return k; }
struct L { struct L *next, *prev; };
int main(void) {
    uintptr_t k = 12345;
    int i = 777;
    int neg = -2;
    unsigned int u = 4000000000u;
    // Call arguments, direct and through a function pointer.
    printf("%lu %lu\n", show(k), show((const void *)k));
    printf("%lu %lu %lu\n", show_c(k), show_i(i), show_pp(i));
    printf("%lu %lu\n", show(0), show_c(0));
    printf("%lu %lu\n", show(u), show_i(u));
    // A signed int sign-extends, an unsigned one zero-extends.
    printf("%d %d\n", show(neg) == (unsigned long)(long)neg,
           (unsigned long)(void *)neg == (unsigned long)(long)neg);
    unsigned long (*fp)(const void *) = show;
    printf("%lu\n", fp(k));
    // Initializers and assignments.
    char *cp = i;
    struct S *sp = (struct S *)0;
    void *vp = (void *)0;
    int *ip = (int *)0;
    printf("%lu %lu\n", (unsigned long)cp, (unsigned long)sp);
    vp = i; cp = k; ip = i; sp = k;
    printf("%lu %lu %lu %lu\n", (unsigned long)vp, (unsigned long)cp,
           (unsigned long)ip, (unsigned long)sp);
    struct P pr = {1, k, i};
    printf("%lu %lu\n", (unsigned long)pr.name, (unsigned long)pr.data);
    char *arr[2] = {k, 0};
    printf("%lu %lu\n", (unsigned long)arr[0], (unsigned long)arr[1]);
    struct P q = (struct P){2, i, 0};
    struct P *qp = &q;
    void *va[2];
    qp->data = k; va[1] = i;
    printf("%lu %lu %lu\n", (unsigned long)q.name, (unsigned long)q.data,
           (unsigned long)va[1]);
    // Comparisons with a pointer.
    printf("%d %d %d %d\n", is_null(0), is_null(k), not_null(0), not_null(k));
    printf("%d %d %d %d\n", same((char *)k, k), same((char *)k, 1),
           differ(k, (char *)k), differ(2, (char *)k));
    // Conditional operands.
    int c = i > 0;
    char *t1 = c ? (char *)0 + 1 : k;
    char *t2 = c ? i : (char *)0;
    char *t3 = c ? 0 : (char *)0 + 3;
    printf("%lu %lu %lu\n", (unsigned long)t1, (unsigned long)t2, (unsigned long)t3);
    char *z = 0;
    printf("%d %d\n", z == 0, 0 != z);
    // Other null pointer constants.
    printf("%lu %lu %lu %lu\n", show(0L), show(0UL), show((long)0),
           show(sizeof(int) - 4));
    printf("%lu %lu %lu\n", show_s(0), (unsigned long)ret_zero(),
           (unsigned long)ret_int(k));
    // An assignment's value has the pointer type: no second conversion.
    char *a1, *a2;
    a1 = a2 = 0;
    struct L n; n.next = n.prev = 0;
    void *c1, *c2; c1 = c2 = i;
    char *c3; c3 = (cp = k);
    unsigned long sv = show(vp = k);
    printf("%lu %lu %lu %lu %lu %lu\n", (unsigned long)a1, (unsigned long)n.next,
           (unsigned long)c1, (unsigned long)c3, sv, (unsigned long)vp);
    if ((vp = i)) printf("set\n");
    if (!(vp = 0)) printf("null\n");
    // Ordering comparisons with an integer.
    char *p100 = (char *)100;
    uintptr_t h = 100;
    printf("%d %d %d %d\n", p100 >= h, p100 <= h - 1, h < p100, h + 1 > p100);
    while (h != NULL) h--;
    printf("%lu\n", h);
    // Pointer ordering is unsigned.
    char *hi = (char *)-16;
    int m1 = -1;
    printf("%d %d %d %d\n", p100 < m1, p100 < -1, hi > p100, hi > 100);
    // An assignment's value has the type of its left side: `[]`, `+` and
    // `-` step by that pointer's element.
    char cb[8] = {'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'};
    int ib[4] = {10, 20, 30, 40};
    uintptr_t kc = (uintptr_t)cb, ki = (uintptr_t)ib;
    char *pc; int *pi; short *ps; double *pd;
    printf("%c %c %d %d %c %d\n", *(pc = kc), (pc = kc)[1], (pi = ki)[1],
           *((pi = ki) + 2), *((pc = kc) + 2), (int)(((pc = kc) + 3) - cb));
    printf("%lu %lu %lu %lu\n", (unsigned long)((pc = 1000) + 1),
           (unsigned long)((ps = 1000) + 1), (unsigned long)((pd = 1000) + 1),
           (unsigned long)((pc = 0) + 1));
    pi = ib;
    printf("%d %c\n", (int)((pc = pi) + 1 - (char *)ib), *((pc = cb) + 1) = 'x');
    return 0;
}
