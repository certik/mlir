    show(c);
    struct P d = {.us = 9, .b = 1, .c = 'x'};
    show(d);
    struct P arr[3] = {{1, 2, 0, 3, 4, 5}, {6, 7, 1, 8, 9, 10}};
    show(arr[0]); show(arr[1]);
    arr[2] = arr[1]; arr[2].s = -9;
    show(arr[2]);
