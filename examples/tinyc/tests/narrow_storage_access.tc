struct P { char c; short s; bool b; unsigned char uc; unsigned short us; int i; };
union U { unsigned int w; unsigned short h[2]; unsigned char b[4]; bool f; signed char sc; };
struct Q { struct P p; char tail; };
struct P make(int k) {
    struct P r;
    r.c = (char)(k + 100); r.s = (short)(k * 1000); r.b = k & 1; r.uc = (unsigned char)(k + 250);
    r.us = (unsigned short)(k - 10); r.i = k;
    return r;
}
int show(struct P p) { return printf("%d %d %d %d %d %d\n", p.c, p.s, p.b, p.uc, p.us, p.i); }
char pass_c(char c) { return c + 1; }
short pass_s(short s) { return s * 2; }
bool pass_b(bool b) { return !b; }
unsigned short pass_us(unsigned short u) { return u + 1; }
unsigned char pass_uc(unsigned char u) { return u + 1; }
int sum_q(struct Q *q) { return q->p.c + q->p.s + q->p.b + q->tail; }
static int part_structs(void) {
    struct P a = make(7);
    show(a);
    struct P b = a;
    b.s += 30000; b.c++; b.b = !b.b; b.us -= 100; b.uc *= 3;
    show(b); show(a);
    struct P c = {-1, -2, 3, 300, 70000, 5};
    show(c);
    struct P d = {.us = 9, .b = 1, .c = 'x'};
    show(d);
    struct P arr[3] = {{1, 2, 0, 3, 4, 5}, {6, 7, 1, 8, 9, 10}};
    show(arr[0]); show(arr[1]);
    arr[2] = arr[1]; arr[2].s = -9;
    show(arr[2]);
    struct Q q; q.p = make(3); q.tail = -5;
    printf("%d\n", sum_q(&q));
    struct Q q2 = q; q2.p.us = 65535;
    printf("%d %d %d\n", q2.p.us, q2.tail, (int)sizeof(struct Q));
    union U u; u.w = 0x80FF7F01u;
    printf("%d %d %d %d %d %d\n", u.h[0], u.h[1], u.b[0], u.b[1], u.b[3], u.sc);
    u.h[1] = 0x1234; u.b[0] = 0xFE;
    printf("%u %d\n", u.w, (int)sizeof(u));
    u.w = 0; u.f = 1;
    printf("%u %d\n", u.w, u.f);
    union U u2 = u; u2.b[2] = 9;
    printf("%u %u\n", u2.w, u.w);
    printf("%d %d %d %d %d\n", pass_c(127), pass_s(20000), pass_b(0), pass_us(65535), pass_uc(255));
    printf("%d %d\n", pass_c(-129), pass_s(-17000));
    struct P *pp = &a;
    pp->s = pp->s + pp->c; pp->b = pp->s; ++pp->uc;
    printf("%d %d %d %d\n", a.s, a.b, a.uc, (int)sizeof(*pp));
    struct P big = (struct P){1, 2, 1, 4, 5, 6};
    show(big);
    return 0;
}
struct F { bool on; unsigned char lvl; short delta; bool flags[4]; };
struct W { char tag; struct F f; union { short s; unsigned char b[2]; } u; };
static void bump(short *p, unsigned char *q, bool *r) { *p += 1000; *q -= 1; *r = !*r; }
static int sum_flags(struct F f) { int n = 0; for (int i = 0; i < 4; i++) n += f.flags[i]; return n + f.on + f.lvl + f.delta; }
static struct F mk(int k) { struct F f; f.on = k & 1; f.lvl = (unsigned char)(k * 50); f.delta = (short)(k * -9000); f.flags[0] = 1; f.flags[1] = 0; f.flags[2] = k > 2; f.flags[3] = 1; return f; }
static int part_fields(void) {
    short s = 32000; unsigned char uc = 0; bool b = 0;
    bump(&s, &uc, &b);
    printf("%d %d %d\n", s, uc, b);
    struct F f = mk(3);
    printf("%d %d %d %d %d\n", f.on, f.lvl, f.delta, f.flags[2], sum_flags(f));
    struct W w; w.tag = 'w'; w.f = mk(5); w.u.s = -2;
    printf("%c %d %d %d %d %d\n", w.tag, w.f.lvl, w.f.delta, w.u.b[0], w.u.b[1], (int)sizeof(w));
    struct W w2 = w; w2.u.b[1] = 0x7f; w2.f.flags[0] = 0;
    printf("%d %d %d %d\n", w2.u.s, w.u.s, w2.f.flags[0], w.f.flags[0]);
    int hist[4] = {0};
    unsigned char data[6] = {0, 255, 128, 3, 64, 200};
    for (int i = 0; i < 6; i++) hist[data[i] >> 6]++;
    printf("%d %d %d %d\n", hist[0], hist[1], hist[2], hist[3]);
    signed char sc = -1; unsigned short us = sc;
    printf("%d %d %d\n", us, sc < us, (unsigned char)sc == 255);
    short sw = -2;
    switch (sw) { case -2: printf("neg2\n"); break; default: printf("other\n"); }
    bool bb = f.lvl > 100 && f.delta < 0;
    printf("%d %d\n", bb, bb ? f.lvl : f.delta);
    short arr[4] = {-1, -2, -3, -4}; short *p = &arr[3];
    printf("%d %d %d\n", p[-1], *(p - 3), (int)(p - arr));
    unsigned char u8 = 200; u8 += u8; printf("%d\n", u8);
    short m = -32768; m--; printf("%d\n", m);
    for (unsigned char c = 250; c != 2; c++) { if (c == 255) printf("wrap\n"); }
    struct F fs[2]; fs[0] = mk(1); fs[1] = fs[0]; fs[1].lvl++;
    printf("%d %d %d\n", fs[0].lvl, fs[1].lvl, (int)((char *)&fs[1] - (char *)&fs[0]));
    return 0;
}
