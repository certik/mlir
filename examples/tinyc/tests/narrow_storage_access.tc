    for (int i = 0; i < 3; i++) rr.f[i] = i - 1;
    for (int i = 0; i < 2; i++) for (int j = 0; j < 3; j++) rr.u[i][j] = (unsigned short)(-(i + j));
    rr.tag = 'z';
    printf("%d %d %d %d %d %d %d %c\n", rr.h[0], rr.h[3], rr.f[0], rr.f[1], rr.f[2], rr.u[0][0], rr.u[1][2], rr.tag);
    struct R *pr = &rr;
    pr->h[1] += 5; pr->f[1] = 7; pr->u[1][1]--;
    printf("%d %d %d %d\n", pr->h[1], pr->f[1], pr->u[1][1], (int)sizeof(rr));
    short *ph = rr.h; ph[2] = -1;
    printf("%d %d\n", rr.h[2], (int)((char *)(rr.h + 1) - (char *)rr.h));
    char x[3], y[5];
    short sx[2], sy[3];
    bool bx[2], by[4];
    char z[] = "hi", w[4] = "ab";
    printf("%d %d %d %d %d %d %d %d\n", (int)sizeof(x), (int)sizeof(y), (int)sizeof(sx), (int)sizeof(sy),
           (int)sizeof(bx), (int)sizeof(by), (int)sizeof(z), (int)sizeof(w));
    for (int i = 0; i < 3; i++) sy[i] = (short)(-i - 1);
    for (int i = 0; i < 5; i++) y[i] = 'a' + i;
    char *py = y;
    printf("%d %d %d %s %s\n", sy[2], *(py + 1), (int)((char *)(y + 1) - py), z, w);
    short init[4] = {1, -2, 70000, -40000};
    bool binit[3] = {0, 5, -1};
    unsigned short uinit[3] = {-1, 65536, 3};
    printf("%d %d %d %d %d %d %d %d %d %d\n", init[0], init[1], init[2], init[3], binit[0], binit[1], binit[2], uinit[0], uinit[1], uinit[2]);
    short zi[3] = {0};
    printf("%d %d %d\n", zi[0], zi[1], zi[2]);
    return 0;
}
struct PS { char c; short s; };
