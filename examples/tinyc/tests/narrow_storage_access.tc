struct T { signed char sc; unsigned char uc; short s; unsigned short us; bool b; };
static int part_ops(void) {
    struct T t = {0};
    t.sc = 127; t.sc++; t.uc = 0; t.uc--; t.s = 32767; t.s += 1; t.us = 0; t.us -= 1; t.b = 2;
    printf("%d %d %d %d %d\n", t.sc, t.uc, t.s, t.us, t.b);
    int x = (t.sc = 300);
    int y = (t.us = -2);
    int z = (t.b = 0.5);
    printf("%d %d %d %d %d %d\n", x, y, z, t.sc, t.us, t.b);
    short arr[3] = {0};
    int w = arr[1] = 40000;
    printf("%d %d\n", w, arr[1]);
    unsigned short ua[2]; ua[0] = 65535; ua[1] = ua[0] + 1;
    printf("%d %d %d\n", ua[0], ua[1], ua[0] * 2);
    bool bs[3]; bs[0] = &x; bs[1] = 0.0; bs[2] = -7;
    printf("%d %d %d\n", bs[0], bs[1], bs[2]);
    short s = -1; unsigned short u = s;
    printf("%d %d %d\n", u, s == u, (short)u == s);
    char c = 'a'; c = c << 2;
    printf("%d\n", c);
    int k = 0;
    for (short i = 32760; i > 0 && k < 20; i++) k++;
    printf("%d\n", k);
    unsigned char cnt = 250; int loops = 0;
    while (cnt != 4) { cnt++; loops++; }
    printf("%d\n", loops);
    short sh = 0x7fff; sh <<= 1; sh >>= 1;
    printf("%d\n", sh);
    unsigned short ush = 0x8000; ush >>= 15;
    printf("%d\n", ush);
    bool f = 1; f += 1; printf("%d\n", f);
    f = 0; f--; printf("%d\n", f);
    signed char m = -128; m = -m; printf("%d\n", m);
    t.s = 1000; t.s *= t.s; printf("%d\n", t.s);
    return 0;
}

int main(void) {
    part_arrays();
    part_ptrs();
    part_ptrptr();
    part_structs();
    part_fields();
    part_globals();
    part_globals2();
