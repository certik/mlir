    unsigned char data[6] = {0, 255, 128, 3, 64, 200};
    for (int i = 0; i < 6; i++) hist[data[i] >> 6]++;
    printf("%d %d %d %d\n", hist[0], hist[1], hist[2], hist[3]);
    signed char sc = -1; unsigned short us = sc;
    printf("%d %d %d\n", us, sc < us, (unsigned char)sc == 255);
    short sw = -2;
    switch (sw) { case -2: printf("neg2\n"); break; default: printf("other\n"); }
    bool bb = f.lvl > 100 && f.delta < 0;
    printf("%d %d\n", bb, bb ? f.lvl : f.delta);
    short arr[4] = {-1, -2, -3, -4}; short *p = &arr[3];
    printf("%d %d %d\n", p[-1], *(p - 3), (int)(p - arr));
    unsigned char u8 = 200; u8 += u8; printf("%d\n", u8);
    short m = -32768; m--; printf("%d\n", m);
    for (unsigned char c = 250; c != 2; c++) { if (c == 255) printf("wrap\n"); }
    struct F fs[2]; fs[0] = mk(1); fs[1] = fs[0]; fs[1].lvl++;
    printf("%d %d %d\n", fs[0].lvl, fs[1].lvl, (int)((char *)&fs[1] - (char *)&fs[0]));
    return 0;
}
