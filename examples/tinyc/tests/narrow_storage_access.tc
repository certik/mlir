    printf("%d %d %d %d %d %s %d %d\n", gba[0], gba[1], gba[2], gba[3], gba[4], gca, (int)sizeof(gsa), (int)sizeof(gba));
    gc += 200; guc += 10; gs -= 30000; gus += 6000; gb = 0;
