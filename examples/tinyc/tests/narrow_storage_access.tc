    printf("%d %d %d\n", (int)((char *)(p + 3) - (char *)p), (int)((char *)(q + 3) - (char *)q), (int)((char *)(r + 3) - (char *)r));
    printf("%d %d %d %d\n", *(p + 2), p[4], *(q + 3), (int)(&a[4] - &a[1]));
    p++; p += 2; printf("%d %d\n", *p, p[-1]);
