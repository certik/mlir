extern int printf(const char *fmt, ...);

// Float literals must be converted to the correctly rounded double: the
// expected output is the IEEE-754 bit pattern of each literal as produced
// by a correctly rounding strtod (Python float()).
static void show(double x) {
    unsigned long long *p = (unsigned long long *)&x;
    printf("%llx\n", *p);
}

int main(void) {
    show(3.14159265358979323846);
    show(6.28318530717958647692);
    show(0.1234567890123456789012345);
    show(12345678901234567890.5);
    show(18446744073709551616.0);
    show(2.718281828459045235360287);
    show(1.7976931348623157);
    show(4.9406564584124654);
    show(0.75);
    show(0.1);
    show(1e22);
    show(1.5e-7);
    show(123456789012345678901234567890.0);
    show(9.999999999999999999);
    show(0.3);
    show(2.5e10);
    show(7.0e-3);
    show(6.01815908301);
    show(71.31860913909960);
    show(0.46281948);
    show(1.9935181909378657975432);
    show(1.94875749118625276018955);
    show(76.79711471049746507529170);
    show(16.3667127);
    show(4552.2684656321223);
    show(0.7924402685995289078666);
    show(1.6031372159010);
    show(8.1590139624595711777);
    show(10.2154728038528084);
    show(1.852538885393363387500);
    show(265.395755131);
    show(201.53799075);
    show(0.637265167612220297299);
    show(19.8820018263304348);
    show(5341.48620579);
    show(846.82828807290222791);
    show(1.888718033401878017);
    show(8282.98347887838);
    show(3319.726167513);
    show(0.41252427316723);
    show(527.656355);
    show(2.587);
    show(1.589481131144024);
    show(869.46288);
    show(717.5140261401419314170);
    show(6844.49208312402);
    show(80.4834782);
    show(2.400088387);
    show(108.67868433);
    show(10.26502014620);
    show(891.849);
    show(5.72247045);
    show(5300.30435205617);
    show(3292.380141269);
    show(23.44);
    show(1.982965724920868288909);
    show(1.00251678008374071881817);
    return 0;
}
