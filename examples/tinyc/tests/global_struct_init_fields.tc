extern int printf(const char *fmt, ...);
// File-scope struct initializers for every field kind: char / short /
// unsigned char / bool narrowing, long long, float, double (-0.0, 1e300),
// null pointers (whose size differs on wasm32), int / char / pointer arrays,
// 2-D arrays with and without inner braces, and constant expressions and
// casts (#292).
struct In { short s; unsigned char uc; double d; };
struct Out {
    char c;
    struct In in;
    int arr[3];
    char name[6];
    long long big;
    float f;
    void *p;
    int m[2][2];
    unsigned u;
    _Bool flag;
};
static struct Out o = { 300, { -2, 300, 2.5 }, { 1, 2 }, "abc", 1234567890123LL, 0.1f, 0, {{1, 2}, {3}}, -1, 5 };
static struct Out o2 = { .name = "xy", .f = -1.25f, .c = 'q' };
static struct Out o3 = { 1, { 2 }, { 0 }, "", 0, 3, (void *)0, {5, 6, 7, 8}, 4000000000u, 0 };
static double after2 = 6.5;
static void part1(void) {
    printf("%d %d %d %.2f\n", o.c, o.in.s, o.in.uc, o.in.d);
    printf("%d %d %d %c%c%c%d %lld %.3f %d\n", o.arr[0], o.arr[1], o.arr[2], o.name[0], o.name[1], o.name[2], o.name[3], o.big, o.f, o.p == 0);
    printf("%d %d %d %d %u %d\n", o.m[0][0], o.m[0][1], o.m[1][0], o.m[1][1], o.u, o.flag);
    printf("%c %c%c%d %.2f %d %d\n", o2.c, o2.name[0], o2.name[1], o2.name[2], o2.f, o2.in.s, o2.arr[2]);
    printf("%d %d %.1f %d %d %d %d %u\n", o3.c, o3.in.s, o3.f, o3.m[0][0], o3.m[0][1], o3.m[1][0], o3.m[1][1], o3.u);
    printf("%.1f\n", after2);
}
struct E { int a; long long b; double c; unsigned char d; int e; };
static struct E x = { 1 + 2 * 3, -1, -3, (unsigned char)257, sizeof(int) * 2 };
static struct E y = { ~0, 1LL << 40, 7 / 2, 'a', 'b' - 'a' };
static struct E z = { (char)200, (short)70000, (float)1.5, -1, 3.9 };
static void part2(void) {
    printf("%d %lld %.2f %d %d\n", x.a, x.b, x.c, x.d, x.e);
    printf("%d %lld %.2f %d %d\n", y.a, y.b, y.c, y.d, y.e);
    printf("%d %lld %.2f %d %d\n", z.a, z.b, z.c, z.d, z.e);
}
struct PP { void *p; int x; char *s; double d; short sh; char *q[2]; long long ll; };
static struct PP pp = { 0, 5, (char *)0, 1.5, -7, { 0, 0 }, -3 };
struct B { _Bool b; unsigned short us; signed char sc; float f; double nz; };
static struct B bb[3] = { { 2, 70000, 200, 3, -0.0 }, { 0, 65535, -1, 2.75f, 1e300 } };
struct D { int a, b, c, d; };
static struct D dd = { .c = 3, 4, .a = 1, 2 };
struct N { struct D x; int y[2][3]; struct D z; };
static struct N nn = { .z = { .b = 9, 1 }, .y = { 1, 2, 3, 4 }, .x = { 7 } };
static int big[1000];
static const struct D cd = { 10, 20, 30, 40 };
static void part3(void) {
    printf("%d %d %d %.2f %d %d %d %lld\n", pp.p == 0, pp.x, pp.s == 0, pp.d, pp.sh, pp.q[0] == 0, pp.q[1] == 0, pp.ll);
    int i;
    for (i = 0; i < 3; i++) printf("%d %d %d %.2f %d %d|", bb[i].b, bb[i].us, bb[i].sc, bb[i].f, bb[i].nz > 1e299, bb[i].nz == 0 && 1.0 / bb[i].nz < 0);
    printf("\n%d %d %d %d\n", dd.a, dd.b, dd.c, dd.d);
    printf("%d %d %d %d %d %d %d %d %d %d\n", nn.x.a, nn.x.b, nn.y[0][0], nn.y[0][2], nn.y[1][0], nn.y[1][2], nn.z.a, nn.z.b, nn.z.c, big[999]);
    printf("%d %d\n", cd.b, cd.d);
    pp.x = 6; bb[2].us = 9;
    printf("%d %d %.2f\n", pp.x, bb[2].us, pp.d);
}
int main(void) {
    part1();
    part2();
    part3();
    return 0;
}
