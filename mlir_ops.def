MLIR_DIALECT_BEGIN(WASMSSA)
// -------------------------------------------------------------------------
// wasmssa dialect — high-level SSA-form WebAssembly ops. Produced by
// the LLVM-dialect -> wasmssa lowering pass and consumed by the
// wasmssa -> wasmstack stackification pass. All values are SSA;
// there are no explicit local.get / local.set / local.tee here.
//
// Op operand-order convention (non-commutative ops):
//   sub:   %r = wasmssa.sub %lhs, %rhs   ; emits "lhs rhs i32.sub"
//   load:  %r = wasmssa.load %addr       ; offset/align as attrs
//   store: wasmssa.store %addr, %val
// -------------------------------------------------------------------------
MLIR_OP(OP_TYPE_WASMSSA_FUNC, "wasmssa.func")
MLIR_OP(OP_TYPE_WASMSSA_IMPORT_FUNC, "wasmssa.import_func")
MLIR_OP(OP_TYPE_WASMSSA_IMPORT_GLOBAL, "wasmssa.import_global")
MLIR_OP(OP_TYPE_WASMSSA_CONST, "wasmssa.const")
MLIR_OP(OP_TYPE_WASMSSA_ADD, "wasmssa.add")
MLIR_OP(OP_TYPE_WASMSSA_SUB, "wasmssa.sub")
MLIR_OP(OP_TYPE_WASMSSA_BINOP, "wasmssa.binop")
MLIR_OP(OP_TYPE_WASMSSA_UNOP, "wasmssa.unop")
MLIR_OP(OP_TYPE_WASMSSA_LOAD, "wasmssa.load")
MLIR_OP(OP_TYPE_WASMSSA_STORE, "wasmssa.store")
MLIR_OP(OP_TYPE_WASMSSA_GLOBAL_GET, "wasmssa.global_get")
MLIR_OP(OP_TYPE_WASMSSA_GLOBAL_SET, "wasmssa.global_set")
MLIR_OP(OP_TYPE_WASMSSA_EXTEND_I32_S, "wasmssa.extend_i32_s")
MLIR_OP(OP_TYPE_WASMSSA_RETURN, "wasmssa.return")
MLIR_OP(OP_TYPE_WASMSSA_CALL, "wasmssa.call")
// Region-bearing structured control flow. Cross-CF value passing is
// modelled via MLIR block arguments on the region's entry block (for
// loops) and via the variadic operands of block_return / br (for all
// three op kinds). Results of the region-bearing op carry the values
// that flow out via fall-through or `br` to its label.
//
//   %r:R* = wasmssa.block ()           : (R*)  { ... }
//   %r:R* = wasmssa.loop  (init:T*)    : (R*)  { ^entry(a:T*): ... }
//   %r:R* = wasmssa.if    (%cond:i32)  : (R*)  { then } else { else }
//
// Region terminators: block_return | br | br_if (non-terminator) |
//                     unreachable | return.
MLIR_OP(OP_TYPE_WASMSSA_BLOCK, "wasmssa.block")
MLIR_OP(OP_TYPE_WASMSSA_LOOP, "wasmssa.loop")
MLIR_OP(OP_TYPE_WASMSSA_IF, "wasmssa.if")
// Region terminator carrying the values that flow out of the enclosing
// wasmssa.block / wasmssa.loop / wasmssa.if via fall-through.
MLIR_OP(OP_TYPE_WASMSSA_BLOCK_RETURN, "wasmssa.block_return")
// Terminator emitting wasm `unreachable` (0x00). Used after wasmssa.loop
// when the loop never falls through (every back-edge `br 0` or outward
// `br N` exits the loop's own end).
MLIR_OP(OP_TYPE_WASMSSA_UNREACHABLE, "wasmssa.unreachable")
// Branch carrying variadic values matching the target label's signature
// (depth-relative). Terminator.
MLIR_OP(OP_TYPE_WASMSSA_BR, "wasmssa.br")
// Conditional branch carrying only the condition; no value operands.
// For value-carrying conditional branches we use `wasmssa.if %cond { br N (vals) }`.
MLIR_OP(OP_TYPE_WASMSSA_BR_IF, "wasmssa.br_if")
MLIR_OP(OP_TYPE_WASMSSA_SELECT, "wasmssa.select")
MLIR_OP(OP_TYPE_WASMSSA_EQZ, "wasmssa.eqz")
MLIR_OP(OP_TYPE_WASMSSA_ADDRESSOF, "wasmssa.addressof")
// Function-pointer support: FUNC_ADDR pushes the table-index of a
// named function (lowered via R_WASM_TABLE_INDEX_SLEB); CALL_INDIRECT
// pops args + table-index and dispatches via wasm `call_indirect`.
MLIR_OP(OP_TYPE_WASMSSA_FUNC_ADDR, "wasmssa.func_addr")
MLIR_OP(OP_TYPE_WASMSSA_CALL_INDIRECT, "wasmssa.call_indirect")
// Wasm function-locals access. Each function has a fixed set of
// typed locals (params + declared locals). LOCAL_GET reads slot
// `local_idx`, LOCAL_SET writes it. Locals are NEVER address-taken
// in wasm semantics, so they live in a native (non-linmem) stack
// frame that the llvm->aarch64 backend allocates. The lifter used
// to spill them into linmem cells (8 bytes each), which inflated
// the wasm stack by ~20x and forced unrealistic stack-size grows.
//   attrs: valtype (i32 byte: i32|i64|f32|f64), local_idx (i32).
MLIR_OP(OP_TYPE_WASMSSA_LOCAL_GET, "wasmssa.local_get")
MLIR_OP(OP_TYPE_WASMSSA_LOCAL_SET, "wasmssa.local_set")
// WebAssembly memory instructions: `memory.size` (0x3F 0x00) and
// `memory.grow` (0x40 0x00). MEMORY_SIZE has no operands and an i32
// result (size in pages). MEMORY_GROW takes one i32 operand (pages
// to grow by) and returns the previous size in pages (or -1 on
// failure) as i32. Both carry a trailing single-byte immediate
// identifying the memory index (always 0 for the default memory).
MLIR_OP(OP_TYPE_WASMSSA_MEMORY_SIZE, "wasmssa.memory_size")
MLIR_OP(OP_TYPE_WASMSSA_MEMORY_GROW, "wasmssa.memory_grow")
MLIR_DIALECT_END(WASMSSA)

MLIR_DIALECT_BEGIN(WASMSTACK)
// -------------------------------------------------------------------------
// wasmstack dialect — low-level stack-machine WebAssembly ops. 1:1
// with the wasm bytecode opcodes. Produced by the wasmssa -> wasmstack
// stackification pass and consumed by the binary emitter.
// -------------------------------------------------------------------------
MLIR_OP(OP_TYPE_WASMSTACK_FUNC, "wasmstack.func")
MLIR_OP(OP_TYPE_WASMSTACK_IMPORT_FUNC, "wasmstack.import_func")
MLIR_OP(OP_TYPE_WASMSTACK_IMPORT_GLOBAL, "wasmstack.import_global")
MLIR_OP(OP_TYPE_WASMSTACK_LOCAL_GET, "wasmstack.local.get")
MLIR_OP(OP_TYPE_WASMSTACK_LOCAL_SET, "wasmstack.local.set")
MLIR_OP(OP_TYPE_WASMSTACK_LOCAL_TEE, "wasmstack.local.tee")
MLIR_OP(OP_TYPE_WASMSTACK_CONST, "wasmstack.const")
MLIR_OP(OP_TYPE_WASMSTACK_ADD, "wasmstack.add")
MLIR_OP(OP_TYPE_WASMSTACK_SUB, "wasmstack.sub")
MLIR_OP(OP_TYPE_WASMSTACK_BINOP, "wasmstack.binop")
MLIR_OP(OP_TYPE_WASMSTACK_UNOP, "wasmstack.unop")
MLIR_OP(OP_TYPE_WASMSTACK_LOAD, "wasmstack.load")
MLIR_OP(OP_TYPE_WASMSTACK_STORE, "wasmstack.store")
MLIR_OP(OP_TYPE_WASMSTACK_GLOBAL_GET, "wasmstack.global.get")
MLIR_OP(OP_TYPE_WASMSTACK_GLOBAL_SET, "wasmstack.global.set")
MLIR_OP(OP_TYPE_WASMSTACK_EXTEND_I32_S, "wasmstack.extend_i32_s")
MLIR_OP(OP_TYPE_WASMSTACK_RETURN, "wasmstack.return")
MLIR_OP(OP_TYPE_WASMSTACK_CALL, "wasmstack.call")
// Structured-CF + select.
MLIR_OP(OP_TYPE_WASMSTACK_BLOCK, "wasmstack.block")
MLIR_OP(OP_TYPE_WASMSTACK_LOOP, "wasmstack.loop")
MLIR_OP(OP_TYPE_WASMSTACK_IF, "wasmstack.if")
MLIR_OP(OP_TYPE_WASMSTACK_ELSE, "wasmstack.else")
MLIR_OP(OP_TYPE_WASMSTACK_END, "wasmstack.end")
MLIR_OP(OP_TYPE_WASMSTACK_BR, "wasmstack.br")
MLIR_OP(OP_TYPE_WASMSTACK_BR_IF, "wasmstack.br_if")
// Terminator emitting wasm `unreachable` (0x00).
MLIR_OP(OP_TYPE_WASMSTACK_UNREACHABLE, "wasmstack.unreachable")
MLIR_OP(OP_TYPE_WASMSTACK_SELECT, "wasmstack.select")
MLIR_OP(OP_TYPE_WASMSTACK_EQZ, "wasmstack.eqz")
MLIR_OP(OP_TYPE_WASMSTACK_ADDRESSOF, "wasmstack.addressof")
MLIR_OP(OP_TYPE_WASMSTACK_FUNC_ADDR, "wasmstack.func_addr")
MLIR_OP(OP_TYPE_WASMSTACK_CALL_INDIRECT, "wasmstack.call_indirect")
// 1:1 wasmstack mirrors of OP_TYPE_WASMSSA_MEMORY_{SIZE,GROW}.
MLIR_OP(OP_TYPE_WASMSTACK_MEMORY_SIZE, "wasmstack.memory_size")
MLIR_OP(OP_TYPE_WASMSTACK_MEMORY_GROW, "wasmstack.memory_grow")
// `drop` (wasm 0x1a): pop one stack value, no result. Only used by
// the wasm -> wasmstack lifter; the C-frontend wasmssa pipeline
// never emits this op.
MLIR_OP(OP_TYPE_WASMSTACK_DROP, "wasmstack.drop")
// `br_table`: emitted by clang for switch dispatch in linked
// runtime objects. Carries a comma-separated list of target depths
// plus a default depth.
MLIR_OP(OP_TYPE_WASMSTACK_BR_TABLE, "wasmstack.br_table")
// Module-level data segment lifted from a wasm DATA section. The
// wasmstack -> wasmssa pass converts this into a wasmssa.import_global
// sized appropriately.
MLIR_OP(OP_TYPE_WASMSTACK_DATA_SEGMENT, "wasmstack.data_segment")
// Module-level global declaration with an initial value. Lifted
// from the wasm GLOBAL section. The backend allocates a static
// i64 slot per global; only the initial value matters.
MLIR_OP(OP_TYPE_WASMSTACK_GLOBAL_DECL, "wasmstack.global_decl")
// Module-level table entry lifted from a wasm ELEM section. Carries
// (slot, target) — i.e. table_slot_index N now contains a reference
// to function `target`. The wasmstack -> wasmssa pass collects these
// and emits a synthetic wasmssa.func "_tinyc_fnptr_init" containing
// one wasmssa.func_addr per entry, so the lifter pre-pass sees them.
MLIR_OP(OP_TYPE_WASMSTACK_FUNC_ADDR_DECL, "wasmstack.func_addr_decl")
MLIR_DIALECT_END(WASMSTACK)

MLIR_DIALECT_BEGIN(AARCH64)
// -------------------------------------------------------------------------
// aarch64 dialect — 1:1 with the AArch64 instruction encoding. The
// `aarch64 → Mach-O` backend is a "dumb" byte emitter; all isel /
// register-allocation knowledge lives in the `llvm → aarch64` lowering.
// First-light slice: just enough to run `int main() { return 42; }`
// and have its return value become the process exit code via a
// direct `svc #0x80` Mach syscall (no `proc_exit` shim required).
// -------------------------------------------------------------------------
MLIR_OP(OP_TYPE_AARCH64_FUNC, "aarch64.func")
MLIR_OP(OP_TYPE_AARCH64_MOVZ, "aarch64.movz")                // movz Wd|Xd, #imm16, LSL #(hw*16)
MLIR_OP(OP_TYPE_AARCH64_MOVK, "aarch64.movk")                // movk Wd|Xd, #imm16, LSL #(hw*16)
MLIR_OP(OP_TYPE_AARCH64_MOV_X, "aarch64.mov_x")              // mov Xd, Xn  (register move; X-form)
MLIR_OP(OP_TYPE_AARCH64_BL, "aarch64.bl")                    // bl <symbol>  (branch-and-link, PC-relative)
MLIR_OP(OP_TYPE_AARCH64_BLR, "aarch64.blr")                  // blr Xn  (indirect branch-and-link via register)
MLIR_OP(OP_TYPE_AARCH64_SVC, "aarch64.svc")                  // svc #imm16
MLIR_OP(OP_TYPE_AARCH64_RET, "aarch64.ret")                  // ret (== ret x30)
// Arithmetic + memory + stack-frame ops added in the arith slice.
MLIR_OP(OP_TYPE_AARCH64_ADD_IMM, "aarch64.add_imm")          // add Wd|Xd, Wn|Xn, #imm12 (LSL 0)
MLIR_OP(OP_TYPE_AARCH64_SUB_IMM, "aarch64.sub_imm")          // sub Wd|Xd, Wn|Xn, #imm12 (LSL 0)
MLIR_OP(OP_TYPE_AARCH64_ADD_REG, "aarch64.add_reg")          // add Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_SUB_REG, "aarch64.sub_reg")          // sub Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_MUL, "aarch64.mul")                  // mul Wd|Xd, Wn|Xn, Wm|Xm  (== madd ..., xzr)
MLIR_OP(OP_TYPE_AARCH64_SDIV, "aarch64.sdiv")                // sdiv Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_UDIV, "aarch64.udiv")                // udiv Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_MSUB, "aarch64.msub")                // msub Wd, Wn, Wm, Wa  (used for srem/urem)
MLIR_OP(OP_TYPE_AARCH64_AND_REG, "aarch64.and_reg")          // and  Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_AND_IMM, "aarch64.and_imm")          // and  Wd|Xd, Wn|Xn, #(1<<w)-1  (low-w-bits mask)
MLIR_OP(OP_TYPE_AARCH64_ORR_REG, "aarch64.orr_reg")          // orr  Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_EOR_REG, "aarch64.eor_reg")          // eor  Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_LSL_REG, "aarch64.lsl_reg")          // lslv Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_LSR_REG, "aarch64.lsr_reg")          // lsrv Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_ASR_REG, "aarch64.asr_reg")          // asrv Wd|Xd, Wn|Xn, Wm|Xm
MLIR_OP(OP_TYPE_AARCH64_LSL_IMM, "aarch64.lsl_imm")          // lsl Wd|Xd, Wn|Xn, #shift  (UBFM alias)
MLIR_OP(OP_TYPE_AARCH64_LSR_IMM, "aarch64.lsr_imm")          // lsr Wd|Xd, Wn|Xn, #shift  (UBFM alias)
MLIR_OP(OP_TYPE_AARCH64_ASR_IMM, "aarch64.asr_imm")          // asr Wd|Xd, Wn|Xn, #shift  (SBFM alias)
MLIR_OP(OP_TYPE_AARCH64_SXTW, "aarch64.sxtw")                // sxtw Xd, Wn  (alias for SBFM)
MLIR_OP(OP_TYPE_AARCH64_SXTB, "aarch64.sxtb")                // sxtb Wd|Xd, Wn  (sign-extend low byte)
MLIR_OP(OP_TYPE_AARCH64_SXTH, "aarch64.sxth")                // sxth Wd|Xd, Wn  (sign-extend low half)
MLIR_OP(OP_TYPE_AARCH64_UXTW, "aarch64.uxtw")                // mov  Wd, Wn  (== orr Wd, WZR, Wn ; zero-extends)
MLIR_OP(OP_TYPE_AARCH64_LDR_W, "aarch64.ldr_w")              // ldr Wd, [Xn, #imm] (i32 unsigned-offset)
MLIR_OP(OP_TYPE_AARCH64_STR_W, "aarch64.str_w")              // str Wd, [Xn, #imm] (i32 unsigned-offset)
MLIR_OP(OP_TYPE_AARCH64_LDR_X, "aarch64.ldr_x")              // ldr Xd, [Xn, #imm] (i64 unsigned-offset)
MLIR_OP(OP_TYPE_AARCH64_STR_X, "aarch64.str_x")              // str Xd, [Xn, #imm] (i64 unsigned-offset)
MLIR_OP(OP_TYPE_AARCH64_STRB_IMM, "aarch64.strb_imm")        // strb Wt, [Xn, #imm12] (1-byte unscaled)
MLIR_OP(OP_TYPE_AARCH64_LDRB_IMM, "aarch64.ldrb_imm")        // ldrb Wt, [Xn, #imm12] (1-byte zero-extend)
MLIR_OP(OP_TYPE_AARCH64_LDR_W_REG, "aarch64.ldr_w_reg")      // ldr  Wt, [Xn, Xm, LSL #0]
MLIR_OP(OP_TYPE_AARCH64_STR_W_REG, "aarch64.str_w_reg")      // str  Wt, [Xn, Xm, LSL #0]
MLIR_OP(OP_TYPE_AARCH64_LDR_X_REG, "aarch64.ldr_x_reg")      // ldr  Xt, [Xn, Xm, LSL #0]
MLIR_OP(OP_TYPE_AARCH64_STR_X_REG, "aarch64.str_x_reg")      // str  Xt, [Xn, Xm, LSL #0]
MLIR_OP(OP_TYPE_AARCH64_LDRB_REG, "aarch64.ldrb_reg")        // ldrb Wt, [Xn, Xm, LSL #0]
MLIR_OP(OP_TYPE_AARCH64_STRB_REG, "aarch64.strb_reg")        // strb Wt, [Xn, Xm, LSL #0]
MLIR_OP(OP_TYPE_AARCH64_STRH_IMM, "aarch64.strh_imm")        // strh Wt, [Xn, #imm] (2-byte, imm scaled by 2)
MLIR_OP(OP_TYPE_AARCH64_LDRH_IMM, "aarch64.ldrh_imm")        // ldrh Wt, [Xn, #imm] (2-byte zero-extend)
// Pseudo: ADRP+ADD pair that resolves to the runtime base address
// of one of the predeclared __DATA regions (vmctx, globals, linmem).
// The macho backend patches the encoded PC-relative immediates
// after layout. Body of the macho-backend tracks this list of
// bases as part of the data-segment layout.
MLIR_OP(OP_TYPE_AARCH64_ADRP_DATA, "aarch64.adrp_data")      // adrp Xd, page_of(<region>)
MLIR_OP(OP_TYPE_AARCH64_ADD_DATA_LO, "aarch64.add_data_lo")  // add  Xd, Xn, #lo12(<region>)
// Function prologue/epilogue (modeled as an op pair so the dumb
// backend can emit the exact instruction sequence; details of
// sp/fp/lr handling baked into the encoder).
MLIR_OP(OP_TYPE_AARCH64_PROLOGUE, "aarch64.prologue")
MLIR_OP(OP_TYPE_AARCH64_EPILOGUE, "aarch64.epilogue")
// Comparison + condition-set. Used to materialise i32 booleans for
// `llvm.icmp` and eqz results.
MLIR_OP(OP_TYPE_AARCH64_CMP_REG, "aarch64.cmp_reg")          // cmp Wn, Wm  (== subs Wzr, Wn, Wm)
MLIR_OP(OP_TYPE_AARCH64_CMP_IMM, "aarch64.cmp_imm")          // cmp Wn, #imm12  (== subs Wzr, Wn, #imm12)
MLIR_OP(OP_TYPE_AARCH64_CSET, "aarch64.cset")                // cset Wd, COND (== csinc Wd, Wzr, Wzr, invert(COND))
// Conditional select. `csel Wd, Wn, Wm, COND`. Used for llvm.select.
MLIR_OP(OP_TYPE_AARCH64_CSEL, "aarch64.csel")
// Control-flow ops. `target` attribute is the symbolic label name.
// The macho backend tracks all `aarch64.label` positions inside a
// function and patches the branch immediates after layout.
MLIR_OP(OP_TYPE_AARCH64_B, "aarch64.b")                      // b <label>     (PC-relative imm26)
MLIR_OP(OP_TYPE_AARCH64_B_COND, "aarch64.b_cond")            // b.<cond> <label> (PC-relative imm19)
MLIR_OP(OP_TYPE_AARCH64_CBZ, "aarch64.cbz")                  // cbz Wn, <label>
MLIR_OP(OP_TYPE_AARCH64_CBNZ, "aarch64.cbnz")                // cbnz Wn, <label>
MLIR_OP(OP_TYPE_AARCH64_LABEL, "aarch64.label")              // pseudo: marks a position; emits 0 bytes
MLIR_OP(OP_TYPE_AARCH64_BRK, "aarch64.brk")                  // brk #imm16 (trap)
// Floating-point ops. Operand and result registers in attributes are
// *V register* numbers (0..31) for the FP slots and GP register
// numbers for the GP slots; the two register files are disjoint, so
// a number like `0` means V0 in an FP slot and W0/X0 in a GP slot.
//
// FMOV between a GP and an FP register; `dir_to_v` chooses direction
// (true: GP→V, false: V→GP). `sf` selects W↔S (false) or X↔D (true).
//   attrs: dir_to_v (bool), sf (bool), rd (i32), rn (i32).
MLIR_OP(OP_TYPE_AARCH64_FMOV_GP_V, "aarch64.fmov_gp_v")
// FADD/FSUB/FMUL/FDIV between two V regs into a V reg.
//   attrs: kind (string: fadd|fsub|fmul|fdiv), fwidth (32|64),
//          rd (i32), rn (i32), rm (i32).
MLIR_OP(OP_TYPE_AARCH64_FP_BINOP, "aarch64.fp_binop")
// FNEG/FABS/FSQRT on a V reg → V reg.
//   attrs: kind (string), fwidth, rd, rn.
MLIR_OP(OP_TYPE_AARCH64_FP_UNOP, "aarch64.fp_unop")
// FCMP Sn/Dn, Sm/Dm — sets NZCV (no rd).
//   attrs: fwidth (32|64), rn (i32), rm (i32).
MLIR_OP(OP_TYPE_AARCH64_FCMP, "aarch64.fcmp")
// FP conversion family. `kind` is one of:
//   "f2f"   — FP-to-FP precision change (FCVT Dd,Sn / FCVT Sd,Dn).
//             rd and rn are both V registers.
//   "f2i"   — FP-to-integer (FCVTZS / FCVTZU). `sign` true => FCVTZS,
//             false => FCVTZU. rd is a GP register, rn is V.
//   "i2f"   — Integer-to-FP (SCVTF / UCVTF). rd is V, rn is GP.
// src_w / dst_w in {32, 64} pick S/W vs D/X.
//   attrs: kind (string), src_w (i32), dst_w (i32), sign (bool),
//          rd (i32), rn (i32).
MLIR_OP(OP_TYPE_AARCH64_FP_CVT, "aarch64.fp_cvt")
// Module-level: a slice of bytes to overlay onto the linmem __DATA
// section at the given offset. The macho backend gathers all of
// these into a single file-backed section that precedes the
// zero-fill portion of linmem.
//   attrs: sym_name (string, debug), offset (i32), init_data (string).
MLIR_OP(OP_TYPE_AARCH64_DATA_INIT, "aarch64.data_init")
MLIR_DIALECT_END(AARCH64)

// -----------------------------------------------------------------------------
// Dialects that only the text parser and the classic printer know.
// -----------------------------------------------------------------------------
MLIR_OP(OP_TYPE_MATH_EXP, "math.exp")
MLIR_OP(OP_TYPE_MATH_LOG, "math.log")
MLIR_OP(OP_TYPE_MEMREF_LOAD, "memref.load")
MLIR_OP(OP_TYPE_MEMREF_STORE, "memref.store")
MLIR_OP(OP_TYPE_MEMREF_ALLOC, "memref.alloc")
MLIR_OP(OP_TYPE_MEMREF_DEALLOC, "memref.dealloc")
MLIR_OP(OP_TYPE_TT_GET_PROGRAM_ID, "tt.get_program_id")
MLIR_OP(OP_TYPE_TT_LOAD, "tt.load")
MLIR_OP(OP_TYPE_TT_STORE, "tt.store")
MLIR_OP(OP_TYPE_TT_MAKE_RANGE, "tt.make_range")
MLIR_OP(OP_TYPE_TT_SPLAT, "tt.splat")
MLIR_OP(OP_TYPE_TT_ADDPTR, "tt.addptr")
MLIR_OP(OP_TYPE_TT_RETURN, "tt.return")
MLIR_OP(OP_TYPE_TT_FUNC, "tt.func")
MLIR_OP(OP_TYPE_TT_CALL, "tt.call")
MLIR_OP(OP_TYPE_TT_REDUCE, "tt.reduce")
MLIR_OP(OP_TYPE_TT_BROADCAST, "tt.broadcast")
MLIR_OP(OP_TYPE_TT_EXPAND_DIMS, "tt.expand_dims")
MLIR_OP(OP_TYPE_TT_DOT, "tt.dot")
MLIR_OP(OP_TYPE_TT_PURE_EXTERN_ELEMENTWISE, "tt.pure_extern_elementwise")
MLIR_OP(OP_TYPE_GPU_LAUNCH, "gpu.launch")
MLIR_OP(OP_TYPE_AFFINE_FOR, "affine.for")
MLIR_OP(OP_TYPE_AFFINE_LOAD, "affine.load")
MLIR_OP(OP_TYPE_VECTOR_PRINT, "vector.print")
MLIR_OP(OP_TYPE_STD_CONSTANT, "std.constant")
MLIR_OP(OP_TYPE_STD_RETURN, "std.return")
MLIR_OP(OP_TYPE_TENSOR_EXTRACT, "tensor.extract")
MLIR_OP(OP_TYPE_TENSOR_SPLAT, "tensor.splat")
MLIR_OP(OP_TYPE_TENSOR_COLLAPSE_SHAPE, "tensor.collapse_shape")
MLIR_OP(OP_TYPE_LINALG_FILL, "linalg.fill")
MLIR_OP(OP_TYPE_LINALG_COPY, "linalg.copy")
MLIR_OP(OP_TYPE_INDEX_CONSTANT, "index.constant")
MLIR_OP(OP_TYPE_TT_REDUCE_RETURN, "tt.reduce.return")

#undef MLIR_OP
#undef MLIR_DIALECT_BEGIN
#undef MLIR_DIALECT_END
