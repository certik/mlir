// -----------------------------------------------------------------------------
// Ops of the dialects that only the text parser and the classic printer know
// (tt, gpu, affine, vector, std, tensor, linalg, index, math, memref). They
// are not MLIR_OpTypes (design decision D9): the parser and the printers
// register these names as dynamic op types of their context
// (MLIR_RegisterOpType) and dispatch on the PARSER_OP_* kinds of
// mlir_printer.h, which map to those per-context types.
// -----------------------------------------------------------------------------
MLIR_PARSER_OP(PARSER_OP_MATH_EXP, "math.exp")
MLIR_PARSER_OP(PARSER_OP_MATH_LOG, "math.log")
MLIR_PARSER_OP(PARSER_OP_MEMREF_LOAD, "memref.load")
MLIR_PARSER_OP(PARSER_OP_MEMREF_STORE, "memref.store")
MLIR_PARSER_OP(PARSER_OP_MEMREF_ALLOC, "memref.alloc")
MLIR_PARSER_OP(PARSER_OP_MEMREF_DEALLOC, "memref.dealloc")
MLIR_PARSER_OP(PARSER_OP_TT_GET_PROGRAM_ID, "tt.get_program_id")
MLIR_PARSER_OP(PARSER_OP_TT_LOAD, "tt.load")
MLIR_PARSER_OP(PARSER_OP_TT_STORE, "tt.store")
MLIR_PARSER_OP(PARSER_OP_TT_MAKE_RANGE, "tt.make_range")
MLIR_PARSER_OP(PARSER_OP_TT_SPLAT, "tt.splat")
MLIR_PARSER_OP(PARSER_OP_TT_ADDPTR, "tt.addptr")
MLIR_PARSER_OP(PARSER_OP_TT_RETURN, "tt.return")
MLIR_PARSER_OP(PARSER_OP_TT_FUNC, "tt.func")
MLIR_PARSER_OP(PARSER_OP_TT_CALL, "tt.call")
MLIR_PARSER_OP(PARSER_OP_TT_REDUCE, "tt.reduce")
MLIR_PARSER_OP(PARSER_OP_TT_BROADCAST, "tt.broadcast")
MLIR_PARSER_OP(PARSER_OP_TT_EXPAND_DIMS, "tt.expand_dims")
MLIR_PARSER_OP(PARSER_OP_TT_DOT, "tt.dot")
MLIR_PARSER_OP(PARSER_OP_TT_PURE_EXTERN_ELEMENTWISE, "tt.pure_extern_elementwise")
MLIR_PARSER_OP(PARSER_OP_GPU_LAUNCH, "gpu.launch")
MLIR_PARSER_OP(PARSER_OP_AFFINE_FOR, "affine.for")
MLIR_PARSER_OP(PARSER_OP_AFFINE_LOAD, "affine.load")
MLIR_PARSER_OP(PARSER_OP_VECTOR_PRINT, "vector.print")
MLIR_PARSER_OP(PARSER_OP_STD_CONSTANT, "std.constant")
MLIR_PARSER_OP(PARSER_OP_STD_RETURN, "std.return")
MLIR_PARSER_OP(PARSER_OP_TENSOR_EXTRACT, "tensor.extract")
MLIR_PARSER_OP(PARSER_OP_TENSOR_SPLAT, "tensor.splat")
MLIR_PARSER_OP(PARSER_OP_TENSOR_COLLAPSE_SHAPE, "tensor.collapse_shape")
MLIR_PARSER_OP(PARSER_OP_LINALG_FILL, "linalg.fill")
MLIR_PARSER_OP(PARSER_OP_LINALG_COPY, "linalg.copy")
MLIR_PARSER_OP(PARSER_OP_INDEX_CONSTANT, "index.constant")
MLIR_PARSER_OP(PARSER_OP_TT_REDUCE_RETURN, "tt.reduce.return")

// Ops the classic printer recognizes although the parser has no form for
// them; the generic printer quotes their names, as for any op it does not
// know.
MLIR_PRINTER_OP(PARSER_OP_AFFINE_YIELD, "affine.yield")
MLIR_PRINTER_OP(PARSER_OP_LINALG_YIELD, "linalg.yield")
MLIR_PRINTER_OP(PARSER_OP_TENSOR_FROM_ELEMENTS, "tensor.from_elements")
MLIR_PRINTER_OP(PARSER_OP_GPU_TERMINATOR, "gpu.terminator")

#undef MLIR_OP
#undef MLIR_OP_ALIAS
#undef MLIR_DIALECT_BEGIN
