// The static op types: one MLIR_OP(enumerator, name, traits) line per op
// (doc/mlir_api_design.md, sections 1.2 and 2.5).
//
// This file is an X-macro: define the macros you need, include it, and the
// lines expand through them. Macros left undefined expand to nothing, and
// the file #undefs all of them at the end, so it can be included any number
// of times (it has no include guard on purpose). It generates
//   - the MLIR_OpType enum and its dialect ranges (mlir_api.h),
//   - the name and traits of each type (mlir_op_names.c),
//   - the op kinds of the parser and the printers (MLIR_PARSER_OP and
//     MLIR_PRINTER_OP, mlir_printer.h).
//
// The ops of a dialect sit between MLIR_DIALECT_BEGIN(D) and
// MLIR_DIALECT_END(D), so their values are consecutive and
// MLIR_DIALECT_<D>_FIRST..MLIR_DIALECT_<D>_LAST is a range check
// (MLIR_OP_TYPE_IN_DIALECT in mlir_api.h). MLIR_OP_ALIAS(enumerator, name)
// gives a static type a second name that lookup and registration accept;
// the type's name stays the MLIR_OP one. Names, aliases included, are unique
// (checked when a context is created). Values are not ABI-stable: everything is rebuilt
// together.
//
// To add an op, add a line to its dialect's block. To add a dialect, add a
// block, and if the dialect exists upstream, load it in
// mlir_api_impl_upstream.cpp (contextRegistry); otherwise upstream treats it
// as an unregistered dialect.

#ifndef MLIR_OP
#define MLIR_OP(enumerator, name, traits)
#endif
#ifndef MLIR_OP_ALIAS
#define MLIR_OP_ALIAS(enumerator, name)
#endif
#ifndef MLIR_DIALECT_BEGIN
#define MLIR_DIALECT_BEGIN(dialect)
#endif
#ifndef MLIR_DIALECT_END
#define MLIR_DIALECT_END(dialect)
#endif
#ifndef MLIR_PARSER_OP
#define MLIR_PARSER_OP(kind, name)
#endif
#ifndef MLIR_PRINTER_OP
#define MLIR_PRINTER_OP(kind, name)
#endif

MLIR_DIALECT_BEGIN(BUILTIN)
// The C side names the module op `module`; upstream calls it `builtin.module`,
// which is an alias: looking it up or registering it gives OP_TYPE_MODULE.
MLIR_OP(OP_TYPE_MODULE, "module", MLIR_T_ISOLATED | MLIR_T_NO_TERMINATOR | MLIR_T_SINGLE_BLOCK | MLIR_T_ZERO_RESULT)
MLIR_OP_ALIAS(OP_TYPE_MODULE, "builtin.module")
MLIR_OP(OP_TYPE_UNREALIZED_CONVERSION_CAST, "builtin.unrealized_conversion_cast", MLIR_T_PURE)
MLIR_DIALECT_END(BUILTIN)

// `return` without a dialect prefix, as the in-tree parser reads the custom
// form of a function's return; it belongs to no dialect.
MLIR_OP(OP_TYPE_RETURN, "return", MLIR_T_TERMINATOR | MLIR_T_RETURN_LIKE | MLIR_T_ZERO_RESULT)

